<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="enrol/orderedapply/db" VERSION="20261020" COMMENT="Ordered course applications">
  <TABLES>
    <TABLE NAME="enrol_orderedapply_app" COMMENT="Applications, with immutable queue time until withdrawal and reapplication">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="enrolid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="firstname" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="lastname" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="email" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="identifier" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="phone" TYPE="char" LENGTH="50" NOTNULL="true"/>
        <FIELD NAME="documents" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="note" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timesubmitted" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="deadline" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="enrol" TYPE="foreign" FIELDS="enrolid" REFTABLE="enrol" REFFIELDS="id"/>
        <KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="enrol-user" UNIQUE="true" FIELDS="enrolid,userid"/>
        <INDEX NAME="queue" UNIQUE="false" FIELDS="enrolid,status,timesubmitted,id"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="enrol_orderedapply_log" COMMENT="Review and application audit history">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="appid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="action" TYPE="char" LENGTH="30" NOTNULL="true"/>
        <FIELD NAME="fromstatus" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="tostatus" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="note" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="app" TYPE="foreign" FIELDS="appid" REFTABLE="enrol_orderedapply_app" REFFIELDS="id"/></KEYS>
    </TABLE>
    <TABLE NAME="enrol_orderedapply_mail" COMMENT="Transactional notification outbox without document contents">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="appid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="body" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timesent" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="app" TYPE="foreign" FIELDS="appid" REFTABLE="enrol_orderedapply_app" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="unsent" UNIQUE="false" FIELDS="timesent"/></INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
